---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
	title: string;
	summary: string;
	image: ImageMetadata;
	imageAlt: string;
	animated?: boolean;
	narrowImage?: boolean;
	href?: string;
	readMore: string;
}

const { title, summary, image, imageAlt, animated = false, narrowImage = false, href, readMore } = Astro.props;
const imageClass = narrowImage ? 'narrow' : undefined;
---

<article>
	<h2>{title}</h2>
	{
		animated ? (
			<img src={image.src} alt={imageAlt} width={image.width} height={image.height} loading="lazy" decoding="async" class={imageClass} />
		) : (
			<Image
				src={image}
				alt={imageAlt}
				widths={[300, 600]}
				sizes="(max-width: 600px) 80vw, (max-width: 800px) 40vw, 300px"
				loading="lazy"
				decoding="async"
				class={imageClass}
			/>
		)
	}
	<p>
		{summary}
		{
			href && (
				<>
					<br />
					<a href={href}>{readMore}</a>
				</>
			)
		}
	</p>
</article>
