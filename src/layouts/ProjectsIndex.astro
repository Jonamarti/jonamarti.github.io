---
import { getCollection } from 'astro:content';
import Base from './Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { areas } from '../data/areas';
import { localizePath, useTranslations, type Lang } from '../i18n/utils';

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const entries = await getCollection('projects', ({ id }) => id.startsWith(`${lang}/`));
entries.sort((a, b) => a.data.order - b.data.order);

const projectsIndex = localizePath('/projects/', lang);

// Real links to the area pages, so the control still works with scripting off. The script
// upgrades them into an in place filter.
const filters = [
	{ id: '', label: t('filter.all'), href: projectsIndex },
	...areas.map((area) => ({ id: area.id, label: area.name[lang], href: localizePath(`/areas/${area.id}/`, lang) })),
];
---

<Base lang={lang} title={t('projects.title')} description={t('projects.description')}>
	<header><h1>{t('projects.heading')}</h1></header>
	<p>{t('projects.intro')}</p>

	<nav class="filters" aria-label={t('filter.label')} data-filters data-template={t('filter.showing')}>
		{
			filters.map((filter) => (
				<a href={filter.href} data-filter={filter.id} aria-current={filter.id === '' ? 'true' : undefined}>
					{filter.label}
				</a>
			))
		}
	</nav>

	<p class="filter-status" data-filter-status role="status" aria-live="polite"></p>

	<section class="projects">
		{
			entries.map((entry) => (
				<ProjectCard
					title={entry.data.title}
					summary={entry.data.summary}
					image={entry.data.image}
					imageAlt={entry.data.imageAlt}
					animated={entry.data.animated}
					narrowImage={entry.data.narrowImage}
					projectAreas={entry.data.areas}
					href={entry.data.detail ? localizePath(`/projects/${entry.id.slice(lang.length + 1)}/`, lang) : undefined}
					readMore={t('projects.readMore')}
				/>
			))
		}
	</section>

	<div class="goUpAnchor">
		<a href="#main-content" aria-label={t('goUp.label')}>&#8593;</a>
	</div>
</Base>

<script>
	import { initAreaFilter } from '../scripts/area-filter';
	initAreaFilter('.projects article');
</script>
